# GN source root for the out-of-tree DUWI Matter Bridge.
#
# `third_party/connectedhomeip` is a git submodule (see .gitmodules) and
# `build_overrides/` is a symlink created by scripts/setup.sh. Together they
# resolve `build_root` and `chip_root` into the read-only connectedhomeip
# checkout, so the SDK tree is never modified.

import("//build_overrides/build.gni")

# The location of the build configuration file.
buildconfig = "${build_root}/config/BUILDCONFIG.gn"

# CHIP uses angle bracket includes.
check_system_includes = true

default_args = {
  import("//args.gni")
}